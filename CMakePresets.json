{
  "version": 8,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_INSTALL_OPTIONS": "--clean-after-build",
        "CMAKE_TOOLCHAIN_FILE": "tools/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ]
}
